{
  "name": "botanical-story", "private": true, "type": "module", "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev --workspace @botanical-story/server\" \"npm:dev --workspace @botanical-story/web\"",
    "build": "npm run build --workspace @botanical-story/web", "typecheck": "tsc --noEmit", "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters", "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx apps/server/src/migrate.ts"
  },
  "devDependencies": { "@types/node": "^22.10.2", "concurrently": "^9.1.2",
    "@playwright/test": "^1.49.1", "typescript": "^5.7.2", "vitest": "^5.0.5" }
}